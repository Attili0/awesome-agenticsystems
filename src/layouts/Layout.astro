---
import fs from 'node:fs';
import path from 'node:path';
import yaml from 'js-yaml';

interface Props {
	title: string;
}

const { title } = Astro.props;

// Load taxonomy for the sidebar
const taxonomyRaw = fs.readFileSync(path.join(process.cwd(), 'src/data/taxonomy.yml'), 'utf-8');
const taxonomy = yaml.load(taxonomyRaw) as any;
const areas = taxonomy.areas;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Awesome Agentic Systems" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
        <header class="site-header">
            <div class="header-container">
                <h1>Awesome Agentic Systems</h1>
                <nav>
                    <a href="https://github.com/juliodosreis/awesome-agenticsystems">GitHub</a>
                </nav>
            </div>
        </header>

        <div class="app-layout">
            <aside class="sidebar">
                <nav class="sidebar-nav">
                    <div class="nav-section">
                        <span class="nav-heading">Explore</span>
                        <a href="/awesome-agenticsystems/">All Papers</a>
                        <a href="/awesome-agenticsystems/areas">Areas Overview</a>
                        <a href="/awesome-agenticsystems/taxonomy">Taxonomy List</a>
                    </div>
                    
                    <div class="nav-section">
                        <span class="nav-heading">Filter by Area</span>
                        {Object.entries(areas).map(([areaKey, areaData]: [string, any]) => (
                            <a href={`/awesome-agenticsystems/areas/${areaKey}`} class="area-link">
                                {areaData.label}
                            </a>
                        ))}
                    </div>
                </nav>
            </aside>
            <main class="main-content">
		        <slot />
            </main>
        </div>
	</body>
</html>
<style is:global>
    :root {
        --bg-color: #0d1117;
        --text-main: #c9d1d9;
        --text-muted: #8b949e;
        --border-color: #30363d;
        --accent-color: #58a6ff;
        --card-bg: #161b22;
        --font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji";
        --sidebar-width: 260px;
    }
    
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        background-color: var(--bg-color);
        color: var(--text-main);
        font-family: var(--font-family);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
    }

    .site-header {
        border-bottom: 1px solid var(--border-color);
        background-color: var(--bg-color);
        position: sticky;
        top: 0;
        z-index: 20;
        height: 60px;
        display: flex;
        align-items: center;
    }

    .header-container {
        width: 100%;
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .site-header h1 {
        font-size: 1.2rem;
        font-weight: 600;
        color: var(--text-main);
        margin: 0;
    }

    .site-header nav a {
        color: var(--text-muted);
        text-decoration: none;
        margin-left: 20px;
        font-size: 0.95rem;
        transition: color 0.2s;
    }

    .site-header nav a:hover {
        color: var(--accent-color);
    }

    .app-layout {
        display: flex;
        flex: 1;
        max-width: 1400px;
        margin: 0 auto;
        width: 100%;
    }

    .sidebar {
        width: var(--sidebar-width);
        flex-shrink: 0;
        border-right: 1px solid var(--border-color);
        padding: 24px;
        position: sticky;
        top: 60px;
        height: calc(100vh - 60px);
        overflow-y: auto;
    }

    .nav-section {
        margin-bottom: 32px;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .nav-heading {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-muted);
        margin-bottom: 8px;
        font-weight: 600;
    }

    .sidebar-nav a {
        color: var(--text-main);
        text-decoration: none;
        font-size: 0.95rem;
        padding: 6px 12px;
        border-radius: 6px;
        margin-left: -12px;
        transition: background-color 0.2s, color 0.2s;
    }

    .sidebar-nav a:hover {
        background-color: rgba(88, 166, 255, 0.1);
        color: var(--accent-color);
    }

    .sidebar-nav .area-link {
        font-size: 0.9rem;
        color: var(--text-muted);
    }

    .sidebar-nav .area-link:hover {
        color: var(--accent-color);
    }

    .main-content {
        flex: 1;
        padding: 32px 48px;
        max-width: 900px;
    }

    a {
        color: var(--accent-color);
        text-decoration: none;
    }

    a:hover {
        text-decoration: underline;
    }

    /* Typography */
    h1, h2, h3, h4 {
        color: var(--text-main);
        margin-bottom: 1rem;
        font-weight: 600;
    }

    p {
        margin-bottom: 1rem;
    }

    @media (max-width: 768px) {
        .app-layout {
            flex-direction: column;
        }
        .sidebar {
            width: 100%;
            height: auto;
            position: static;
            border-right: none;
            border-bottom: 1px solid var(--border-color);
            padding: 16px 24px;
        }
        .main-content {
            padding: 24px;
        }
    }
</style>
