---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';
import yaml from 'js-yaml';


export async function getStaticPaths() {
  const papers = await getCollection('papers');
  const taxonomyRaw = fs.readFileSync(path.join(process.cwd(), 'src/data/taxonomy.yml'), 'utf-8');
  const taxonomy = yaml.load(taxonomyRaw) as any;


  const areas = taxonomy.areas;


  return Object.keys(areas).map(areaKey => {
    return {
      params: { area: areaKey },
      props: {
        areaData: areas[areaKey],
        papers: papers.filter(p => p.data.area === areaKey)
      }
    };
  });
}

const { area } = Astro.params;
const { areaData, papers } = Astro.props;
---

<Layout title={`${areaData.label} | Awesome Agentic Systems`}>
  <div class="breadcrumb">
    <a href="/awesome-agenticsystems/">← Back to Areas</a>
  </div>

  <div class="area-header">
    <h2>{areaData.label}</h2>
    <p>{areaData.blurb}</p>
    <div class="meta">
      <span>{papers.length} papers</span>
    </div>
  </div>

  <div class="paper-list">
    {papers.map(paper => (
      <a href={`/awesome-agenticsystems/papers/${paper.data.id}`} class="paper-card">
        <div class="paper-title">{paper.data.title}</div>
        <div class="paper-authors">{paper.data.authors.join(', ')} ({paper.data.year})</div>
        <div class="paper-topics">
          {paper.data.topics.map((t: string) => (
            <span class="topic-tag">{t}</span>
          ))}
        </div>
      </a>
    ))}
    {papers.length === 0 && (
      <div class="empty-state">No papers categorized in this area yet.</div>
    )}
  </div>
</Layout>

<style>
  .breadcrumb {
    margin-bottom: 24px;
  }
  
  .breadcrumb a {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .breadcrumb a:hover {
    color: var(--accent-color);
  }

  .area-header {
    margin-bottom: 40px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border-color);
  }

  .area-header h2 {
    font-size: 2rem;
    color: var(--text-main);
  }

  .area-header p {
    color: var(--text-muted);
    font-size: 1.1rem;
    max-width: 800px;
  }

  .meta {
    margin-top: 16px;
    font-size: 0.9rem;
    color: var(--accent-color);
    font-weight: 500;
  }

  .paper-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .paper-card {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    padding: 20px;
    border-radius: 8px;
    transition: border-color 0.2s;
    text-decoration: none;
    display: block;
  }

  .paper-card:hover {
    border-color: var(--accent-color);
    text-decoration: none;
  }

  .paper-title {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--text-main);
    margin-bottom: 8px;
  }

  .paper-authors {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 16px;
  }

  .paper-topics {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .topic-tag {
    background: rgba(139, 148, 158, 0.1);
    color: var(--text-muted);
    padding: 2px 8px;
    border-radius: 12px;
    font-size: 0.8rem;
  }

  .empty-state {
    color: var(--text-muted);
    font-style: italic;
    padding: 40px 0;
  }
</style>
