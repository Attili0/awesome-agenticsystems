---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const papers = await getCollection('papers');
  
  return papers.map(paper => ({
    params: { id: paper.data.id },
    props: { paper }
  }));
}

const { paper } = Astro.props;
---

<Layout title={`${paper.data.title} | Awesome Agentic Systems`}>
  <div class="breadcrumb">
    <a href={`/awesome-agenticsystems/areas/${paper.data.area}`}>← Back to Area</a>
  </div>

  <div class="paper-header">
    <h2>{paper.data.title}</h2>
    <div class="authors">{paper.data.authors.join(', ')}</div>
    
    <div class="metadata-grid">
      <div class="meta-item">
        <span class="label">Year</span>
        <span class="value">{paper.data.year}</span>
      </div>
      {paper.data.venue && (
        <div class="meta-item">
          <span class="label">Venue</span>
          <span class="value">{paper.data.venue}</span>
        </div>
      )}
      {paper.data.arxiv && (
        <div class="meta-item">
          <span class="label">arXiv</span>
          <span class="value"><a href={`https://arxiv.org/abs/${paper.data.arxiv}`} target="_blank">{paper.data.arxiv}</a></span>
        </div>
      )}
      <div class="meta-item links">
        <a href={paper.data.links.paper} target="_blank" class="btn primary">Read Paper</a>
        {paper.data.links.code && (
          <a href={paper.data.links.code} target="_blank" class="btn secondary">View Code</a>
        )}
      </div>
    </div>
  </div>

  <div class="content-section">
    {paper.data.tldr && (
      <div class="section-block">
        <h3>TL;DR</h3>
        <p>{paper.data.tldr}</p>
      </div>
    )}

    {paper.data.notes && (
      <div class="section-block">
        <h3>Notes</h3>
        <p>{paper.data.notes}</p>
      </div>
    )}

    <div class="tags-section">
      <h3>Taxonomy</h3>
      <div class="tag-group">
        <span class="tag-label">Area</span>
        <a href={`/awesome-agenticsystems/areas/${paper.data.area}`} class="tag area-tag">{paper.data.area}</a>
      </div>
      
      <div class="tag-group">
        <span class="tag-label">Topics</span>
        <div class="tags">
          {paper.data.topics.map((t: string) => <span class="tag">{t}</span>)}
        </div>
      </div>

      <div class="tag-group">
        <span class="tag-label">Capabilities</span>
        <div class="tags">
          {paper.data.capability.map((c: string) => <span class="tag">{c}</span>)}
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .breadcrumb {
    margin-bottom: 32px;
  }
  
  .breadcrumb a {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .breadcrumb a:hover {
    color: var(--accent-color);
  }

  .paper-header {
    margin-bottom: 40px;
  }

  .paper-header h2 {
    font-size: 2.2rem;
    color: var(--text-main);
    line-height: 1.3;
    margin-bottom: 12px;
  }

  .authors {
    font-size: 1.1rem;
    color: var(--text-muted);
    margin-bottom: 24px;
  }

  .metadata-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    background: var(--card-bg);
    padding: 20px;
    border-radius: 8px;
    border: 1px solid var(--border-color);
    align-items: center;
  }

  .meta-item {
    display: flex;
    flex-direction: column;
  }

  .meta-item .label {
    font-size: 0.8rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 4px;
  }

  .meta-item .value {
    font-size: 1rem;
    color: var(--text-main);
  }

  .links {
    flex-direction: row;
    gap: 12px;
    margin-left: auto;
  }

  .btn {
    padding: 8px 16px;
    border-radius: 6px;
    font-size: 0.95rem;
    font-weight: 500;
    transition: all 0.2s;
  }

  .btn.primary {
    background: var(--accent-color);
    color: #000;
  }

  .btn.primary:hover {
    background: #3a82f6;
    text-decoration: none;
  }

  .btn.secondary {
    background: transparent;
    color: var(--accent-color);
    border: 1px solid var(--accent-color);
  }

  .btn.secondary:hover {
    background: rgba(88, 166, 255, 0.1);
    text-decoration: none;
  }

  .section-block {
    margin-bottom: 40px;
  }

  .section-block h3 {
    font-size: 1.4rem;
    color: var(--text-main);
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 8px;
    margin-bottom: 16px;
  }

  .section-block p {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text-main);
  }

  .tags-section {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    padding: 24px;
    border-radius: 8px;
  }

  .tags-section h3 {
    margin-bottom: 20px;
    font-size: 1.2rem;
  }

  .tag-group {
    margin-bottom: 16px;
  }

  .tag-group:last-child {
    margin-bottom: 0;
  }

  .tag-label {
    display: block;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 8px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tag {
    background: rgba(139, 148, 158, 0.1);
    color: var(--text-muted);
    padding: 4px 12px;
    border-radius: 12px;
    font-size: 0.85rem;
    text-decoration: none;
  }

  .area-tag {
    background: rgba(88, 166, 255, 0.1);
    color: var(--accent-color);
    display: inline-block;
  }

  .area-tag:hover {
    text-decoration: underline;
  }
</style>
